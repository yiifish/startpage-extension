{
  "manifest_version": 3,
  "name": "简约起始页",
  "version": "1.0.0",
  "description": "优雅简约的起始页：搜索引擎（百度 / Google / 豆包 / DeepSeek）+ 快捷收藏，替代默认新标签页",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "startpage.html"
  },
  "host_permissions": [
    "http://127.0.0.1:3080/*"
  ]
}
